<?xml version="1.0" encoding="utf-8"?>
<!--
  Banana / Joyful Smile — X-ray system patient-handoff REFERENCE
  ==============================================================
  This file is the OWNED contract reference for THIS imaging system only.
  It is NOT shared with other installer-* packages and must NOT be overwritten
  by build-installer-packages.ps1 (which only syncs engine .ps1 files).

  Develop this system's handoff independently:
    - Change fields / formats here when the vendor contract changes
    - Keep other systems' reference/*.xml untouched
    - Runtime code lives in xray-local-launcher.ps1 (EnabledSystems isolates)
  Sample chart is fictional (smoke/self-test style). Do not use on real patients.

  Confirmed live 2026-10-22 on XRAY-MCP via Clinic Solution session watcher:
    existing: TW.exe -P\\RECEPTION_MCP\IMAGE\SCAN\003501 -N{label} -F{label}
    new "testing": create SCAN\003510\ + FILEDATA.TXT, then TW.exe -P...\003510 -NTESTING -FTESTING
-->
<BananaXrayHandoffReference
    systemKey="trophy"
    aliasKeys="carestream"
    displayName="Carestream MCP (Trophy TW.exe / Patient Browser)"
    bananaOpenPath="/open/trophy"
    bananaOpenPathAlias="/open/carestream"
    csxrayProtocol="csxray://open/trophy"
    handoffMode="server-tw-filedata-plus-client-patient-exe"
    runtimeWriter="Start-TrophyTwPatient / Ensure-TrophyScanPatientFolder / Start-CarestreamImagingPatient"
    confirmed="2026-10-22"
    independent="true">

  <Notes>
    <Note>Capture / xray-server PC (TW.exe present): Banana Carestream and Trophy buttons both use Start-TrophyTwPatient — same Clinic Solution order: seed SCAN\{chart}\ + FILEDATA.TXT when missing, then TW.exe -P...\SCAN\{chart} -N{label} -F{label}. Existing charts keep FILEDATA; TW refreshes PatientInfo.xml. Live Clinic Solution uses unquoted -P; Banana matches that (quotes only if the path contains spaces).</Note>
    <Note>Consultation client (Patient.exe only, no TW.exe): public desktop "CS Imaging Software.lnk" -> Patient.exe with no switches. Patient.exe reports Unknown option P if given Trophy's -P. Bridge writes the patient name into the live-filter Win32 Edit (carestream-paste-search.ps1). For new patients (no SCAN folder), bridge also opens Patient Card and prefills English name, DOB, chart, HKID/SSN, gender (carestream-fill-patient-card.ps1); staff clicks Create patient.</Note>
    <Note>SCAN roots are PC-role specific (see xray-launcher-config.ps1 generated by this installer).</Note>
    <Note>Independent of Rayscan / EzDent / NNT / Digirex handoff files.</Note>
  </Notes>

  <NativePayload fileName="FILEDATA.TXT" encoding="windows-1252" locationHint="\\RECEPTION_MCP\IMAGE\SCAN\{chart}\FILEDATA.TXT (new charts only)">
    <CommandLine exe="TW.exe" role="xray-server-existing">
      <Arg>-P\\RECEPTION_MCP\IMAGE\SCAN\003501</Arg>
      <Arg>-NWONG YIK YU FINIAN  黃亦愉</Arg>
      <Arg>-FWONG YIK YU FINIAN  黃亦愉</Arg>
    </CommandLine>
    <CommandLine exe="TW.exe" role="xray-server-new">
      <Arg>-P\\RECEPTION_MCP\IMAGE\SCAN\003510</Arg>
      <Arg>-NTESTING</Arg>
      <Arg>-FTESTING</Arg>
    </CommandLine>
    <CommandLine exe="Patient.exe" role="consultation-client">
      <Arg></Arg>
    </CommandLine>
  </NativePayload>

  <FileDataSample chart="003510" name="TESTING">
    <Line>[Patient file]</Line>
    <Line>NUMERO=003510</Line>
    <Line>NOM=TESTING</Line>
    <Line>PRENOM=TESTING</Line>
    <Line>DATE=19840815</Line>
    <Line>EXTNUM=003510</Line>
  </FileDataSample>

  <FieldMap>
    <Field banana="patient_name (then chinese_name)" native="Patient.exe search box (live filter Edit)" transform="Build-CarestreamSearchText; carestream-paste-search.ps1 EM_REPLACESEL" />
    <Field banana="patient_name" native="Patient Card First/Last name" transform="Split-RayPatientName; carestream-fill-patient-card.ps1" />
    <Field banana="dob" native="Patient Card Day/Month/Year" transform="Convert-CarestreamBirthDate; carestream-fill-patient-card.ps1" />
    <Field banana="patient_no" native="Patient Card Patient identifier" transform="Convert-NntPatientId; carestream-fill-patient-card.ps1" />
    <Field banana="hkid" native="Patient Card SSN" transform="carestream-fill-patient-card.ps1" />
    <Field banana="sex" native="Patient Card Gender" transform="Convert-NntSex; carestream-fill-patient-card.ps1" />
    <Field banana="patient_no" native="SCAN\{6-digit chart} + FILEDATA NUMERO/EXTNUM + TW -P path" transform="Get-TrophyPreferredChartId; Convert-NntPatientId" />
    <Field banana="patient_name + chinese_name" native="TW -N / -F glued bilingual label" transform="Build-TrophyTwUiLabel" />
    <Field banana="patient_name" native="FILEDATA NOM/PRENOM (ASCII; single token duplicated)" transform="Build-TrophyFileDataNames" />
    <Field banana="dob" native="FILEDATA DATE=yyyyMMdd" transform="Convert-CarestreamBirthDate" />
    <Field banana="dob" native="-ByyyyMMdd" transform="Convert-CarestreamBirthDate" />
  </FieldMap>

  <DryRun>
    <Url>http://127.0.0.1:17890/open/trophy?dry_run=1&amp;patient_no=001287&amp;patient_name=SMOKE%20QUIET&amp;sex=M</Url>
    <Url>http://127.0.0.1:17890/open/carestream?dry_run=1&amp;patient_no=001287&amp;patient_name=SMOKE%20QUIET&amp;sex=M</Url>
  </DryRun>
</BananaXrayHandoffReference>
