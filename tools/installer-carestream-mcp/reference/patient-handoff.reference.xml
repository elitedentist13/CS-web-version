<?xml version="1.0" encoding="utf-8"?>
<!--
  Banana / Joyful Smile — X-ray system patient-handoff REFERENCE
  ==============================================================
  This file is the OWNED contract reference for THIS imaging system only.
  It is NOT shared with other installer-* packages and must NOT be overwritten
  by build-installer-packages.ps1 (which only syncs engine .ps1 files).

  Develop this system's handoff independently:
    - Change fields / formats here when the vendor contract changes
    - Keep other systems' reference/*.xml untouched
    - Runtime code lives in xray-local-launcher.ps1 (EnabledSystems isolates)
  Sample chart is fictional (smoke/self-test style). Do not use on real patients.

  Carestream button (2026-10-22): always the public desktop icon
    C:\Users\Public\Desktop\CS Imaging Software.lnk
  Patient info is aligned after that launch (live-filter name, Patient Card
  for a new chart). Trophy / TW.exe is a different button: /open/trophy.
-->
<BananaXrayHandoffReference
    systemKey="trophy"
    aliasKeys="carestream"
    displayName="Carestream CS Imaging (desktop shortcut)"
    bananaOpenPath="/open/carestream"
    bananaOpenPathAlias="/open/trophy"
    csxrayProtocol="csxray://open/carestream"
    handoffMode="cs-imaging-desktop-shortcut"
    runtimeWriter="Start-CarestreamImagingPatient"
    desktopShortcut="C:\Users\Public\Desktop\CS Imaging Software.lnk"
    confirmed="2026-10-22"
    independent="true">

  <Notes>
    <Note>The CS Imaging (Carestream) button is inactive. Do not launch C:\Users\Public\Desktop\CS Imaging Software.lnk or Patient.exe from Banana. That window does not load these films and it takes over Trophy. /open/carestream returns mode carestream_inactive and starts nothing. Use Trophy (/open/trophy, TW.exe).</Note>
    <Note>Align Banana patient into that window: carestream-paste-search.ps1 writes the patient name into the live-filter Edit. When no SCAN folder exists yet, carestream-fill-patient-card.ps1 opens Patient Card and prefills English name, DOB, chart, HKID/SSN, and gender; staff clicks Create patient. Start-CarestreamImagingPatient.</Note>
    <Note>Trophy is a different path (/open/trophy, installer-trophy): TW.exe plus FILEDATA.TXT via Start-TrophyTwPatient / Ensure-TrophyScanPatientFolder. Do not use that path for the Carestream button.</Note>
    <Note>Independent of Rayscan / EzDent / NNT / Digirex handoff files.</Note>
  </Notes>

  <NativePayload fileName="CS Imaging Software.lnk" encoding="utf-8" locationHint="C:\Users\Public\Desktop\CS Imaging Software.lnk">
    <CommandLine exe="Patient.exe" role="carestream-desktop-shortcut">
      <Arg></Arg>
    </CommandLine>
  </NativePayload>

  <FieldMap>
    <Field banana="patient_name (then chinese_name)" native="Patient.exe search box (live filter Edit)" transform="Build-CarestreamSearchText; carestream-paste-search.ps1 EM_REPLACESEL" />
    <Field banana="patient_name" native="Patient Card First/Last name" transform="Split-RayPatientName; carestream-fill-patient-card.ps1" />
    <Field banana="dob" native="Patient Card Day/Month/Year" transform="Convert-CarestreamBirthDate; carestream-fill-patient-card.ps1" />
    <Field banana="patient_no" native="Patient Card Patient identifier" transform="Convert-NntPatientId; carestream-fill-patient-card.ps1" />
    <Field banana="hkid" native="Patient Card SSN" transform="carestream-fill-patient-card.ps1" />
    <Field banana="sex" native="Patient Card Gender" transform="Convert-NntSex; carestream-fill-patient-card.ps1" />
  </FieldMap>

  <DryRun>
    <Url>http://127.0.0.1:17890/open/trophy?dry_run=1&amp;patient_no=001287&amp;patient_name=SMOKE%20QUIET&amp;sex=M</Url>
    <Url>http://127.0.0.1:17890/open/carestream?dry_run=1&amp;patient_no=001287&amp;patient_name=SMOKE%20QUIET&amp;sex=M</Url>
  </DryRun>
</BananaXrayHandoffReference>
