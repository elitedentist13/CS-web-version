# Copy to online-booking.env (never commit the real file).

# Supabase — required for local API (tools/online-booking-api.mjs)
SUPABASE_URL=https://kprihawipljrltfzpfjd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste_your_service_role_key_here

# Twilio Verify — SMS OTP (NO Twilio phone number purchase required)
# Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 1 = require OTP when Verify SID is set; 0 = legacy direct booking
ONLINE_BOOKING_OTP_ENABLED=1

# Optional: extra API debug fields (never returns the OTP code)
ONLINE_BOOKING_DEBUG=0
ONLINE_BOOKING_PORT=8788

# ── Twilio WhatsApp (live Edge — set these in Supabase Secrets, not only here) ──
# See TWILIO_WHATSAPP_TEST.md
# Deploy: supabase functions deploy twilio-whatsapp --no-verify-jwt
# TWILIO_WHATSAPP_FROM=whatsapp:+85291234567
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
