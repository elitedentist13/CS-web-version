# Secrets — never commit
tools/.env
.env
.env.*
online-booking.env
twilio-whatsapp.env

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store

# Windows shortcuts (local paths)
*.lnk

# Local config / state files (machine-specific, not for version control)
swcfg.dat
swcfg.bck
CB3DConfig.dat
*.dat
*.bck
PATH.txt
settings.txt
xray-pc-config.js
VTE2Loader32.exe

# Local CS SQL DSN probes (contain internal hosts and password guesses)
_probe-cs-dsn.ps1
_probe-mcp-cs.ps1
_probe-cs-*.ps1

# Logs
server.log
gh-auth-log.txt
*.log

# Local ZIP bundles
tools.zip
*.zip

# Node / build artefacts
node_modules/
.cache/

# X-ray AI service: local venv, downloaded model weights, bytecode
xray-ai-service/.venv/
xray-ai-service/model_cache/
__pycache__/
*.pyc

# apply_xray_ai_extras.py's own "installed payload" record -- a straight
# copy of xray-ai-deploy-pack/extras/<date>/ (the tracked canonical source)
# written into the clinic folder every time the installer runs. Purely
# derived/reproducible, not something to hand-edit or commit.
xray-ai-extras/

# Caries subsystem (panoramic model): trained weights, prepared datasets, training runs
xray-ai-service/caries/weights/
xray-ai-service/caries/train/dataset/
xray-ai-service/caries/train/dataset_continual/
xray-ai-service/caries/train/raw/
xray-ai-service/_samples/
xray-ai-service/caries/train/runs/
runs/
*.pt
*.onnx

# PA/bitewing subsystem: same shape as caries/, separate model + dataset
xray-ai-service/pabw/weights/
xray-ai-service/pabw/train/dataset/
xray-ai-service/pabw/train/dataset_continual/
xray-ai-service/pabw/train/raw/
xray-ai-service/pabw/train/runs/

# Continual-learning capture — contains PATIENT RADIOGRAPHS. Never commit.
xray-ai-service/caries/clinic_data/
xray-ai-service/pabw/clinic_data/

# Note: the folders above are re-created automatically by the service on
# startup (see service/config.py), so they don't need to be tracked empty.

# Dev-only DENTEX validation harness (xray-ai-service/eval/): the harness
# script is committed, the dataset it points at is not — DENTEX is
# CC BY-NC-SA 4.0 (non-commercial) and is downloaded locally by whoever runs
# the eval, never bundled with the service. See eval/README.md.
xray-ai-service/eval/data/
xray-ai-service/eval/reports/
